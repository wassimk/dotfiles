#!/usr/bin/env bash
#
# Focus the herdr workspace labeled NAME, creating it rooted at DIR when it
# does not exist yet. DIR defaults to the current directory.
#
# usage: herdr-workspace NAME [DIR]

set -euo pipefail

name="${1:?usage: herdr-workspace NAME [DIR]}"
dir="${2:-$PWD}"
herdr="${HERDR_BIN_PATH:-herdr}"

id=$("$herdr" workspace list 2>/dev/null \
  | jq -r --arg name "$name" '.result.workspaces[] | select(.label == $name) | .workspace_id' \
  | head -n 1)

if [ -n "$id" ]; then
  "$herdr" workspace focus "$id" >/dev/null
else
  "$herdr" workspace create --cwd "$dir" --label "$name" --focus >/dev/null
fi
