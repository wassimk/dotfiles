# Ghostty configuration

# https://ghostty.org/docs/install/pre#macos
auto-update-channel = stable

# Window
window-decoration = auto
macos-titlebar-style = hidden
window-padding-x = 1
window-padding-y = 1
link-url
mouse-hide-while-typing
macos-auto-secure-input
macos-secure-input-indication

# Keep the block cursor instead of shell integration's bar at the prompt
shell-integration-features = no-cursor

# Quit instance without confirmation
quit-after-last-window-closed = true
confirm-close-surface = false

# Font
font-family = MonoLisaCode
font-family = Symbols Nerd Font
# https://www.monolisa.dev/playground
# v3: alt {} (), hex x, thin backslash, alt $ &, alt .= ..=, all coding ligatures
font-feature = +ss11, +ss10, +ss13, +ss12, +ss08, +ss09, +cv10, +dlig, +zero
font-size = 12
font-thicken

# Colors - One Dark theme
background = 1e2127
foreground = abb2bf

# Normal colors
palette = 0=#1e2127
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#d19a66
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#828791

# Bright colors
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#d19a66
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#e6efff

# Keybindings

# shell type lf<enter> to launch file finder
keybind = super+f=text:lf\r

keybind = shift+enter=text:\x1b\r
