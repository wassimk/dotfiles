# Ghostty configuration

# https://ghostty.org/docs/install/pre#macos
auto-update-channel = stable

# Window
window-decoration = auto
macos-titlebar-style = hidden
window-padding-x = 1
window-padding-y = 1
link-url
mouse-hide-while-typing
macos-auto-secure-input
macos-secure-input-indication

# Make cursor a block outside of herdr
shell-integration-features = no-cursor

# Quit instance without confirmation
quit-after-last-window-closed = true
confirm-close-surface = false

# Font
font-family = MonoLisa Variable
font-family = Symbols Nerd Font
# https://www.monolisa.dev/playground
font-feature = +ss07, +ss08, +ss11, +ss12, +ss13, +ss13, +ss14, +ss17, +zero
font-size = 12
font-thicken

# Colors - One Dark theme
background = 1e2127
foreground = abb2bf

# Normal colors
palette = 0=#1e2127
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#d19a66
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#828791

# Bright colors
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#d19a66
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#e6efff

# Keybindings

# shell type lf<enter> to launch file finder
keybind = super+f=text:lf\r

# herdr copy mode
keybind = super+left_bracket=text:\x13[

# herdr workspace picker
keybind = super+k=text:\x13w

# herdr new workspace picker (fzf: pick folder or type name)
keybind = super+shift+k=text:\x13K

# herdr goto picker (agents, tabs, workspaces)
keybind = super+l=text:\x13g


# herdr new tab
keybind = super+t=text:\x13c

# herdr split down
keybind = super+n=text:\x13-

# herdr split right
keybind = super+shift+n=text:\x13v

# herdr close the current pane
keybind = super+w=text:\x13x

# herdr rename the current tab
keybind = super+comma=text:\x13,

# herdr rename the current workspace
keybind = super+period=text:\x13W

# Disable Ghostty's default tab switching to allow herdr tab switching
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind

# Enable herdr tab switching
keybind = super+one=text:\x131
keybind = super+two=text:\x132
keybind = super+three=text:\x133
keybind = super+four=text:\x134
keybind = super+five=text:\x135
keybind = super+six=text:\x136
keybind = super+seven=text:\x137
keybind = super+eight=text:\x138
keybind = super+nine=text:\x139

# herdr break the current pane out into its own tab
keybind = super+shift+t=text:\x13B

# herdr toggle the zoom state of the current pane
keybind = super+z=text:\x13z

# herdr previous / next tab
keybind = super+shift+left_bracket=text:\x13p
keybind = super+shift+right_bracket=text:\x13n
keybind = shift+enter=text:\x1b\r
